TELEGRAM_BOT_TOKEN=
DATABASE_URL=

# Chat model (any OpenAI-compatible API)
LLM_BASE_URL=
LLM_API_KEY=
# Small, fast, cheap model (runs on most messages)
CAPTURE_MODEL=
# Stronger model (/ask, /catchup, /plan)
ASK_MODEL=
# /ask: skip the LLM if the best chunk's cosine distance is above this and there are no decisions
ASK_MAX_DISTANCE=0.6
# Disable model reasoning/thinking (OpenRouter `reasoning` param). Set to "off" or leave blank.
LLM_REASONING=off
# OpenRouter provider routing, e.g. "throughput" prefers faster providers
LLM_PROVIDER_SORT=throughput
# Response caps
CAPTURE_MAX_TOKENS=200
ASK_MAX_TOKENS=600

# Embeddings (any OpenAI-compatible API; can be a different provider)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Must match the embedding model's output size
EMBEDDING_DIM=
DEFAULT_TZ=Asia/Singapore
PRIVACY_URL=
LOG_LEVEL=INFO
